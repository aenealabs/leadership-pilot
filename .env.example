# LLM provider: "replay" (offline demo), "anthropic" (Claude API), or "foundry" (Claude on Microsoft Foundry)
LP_LLM_PROVIDER=replay
LP_MODEL=claude-opus-5-5
LP_RECORD=false
LP_DB_PATH=leadership_pilot.db
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource   # with LP_LLM_PROVIDER=foundry

# Sign-in: demo (default) | oidc (Microsoft Entra ID or any OIDC provider)
LP_AUTH=demo
# LP_OIDC_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# LP_OIDC_CLIENT_ID=
# LP_OIDC_CLIENT_SECRET=
# LP_SESSION_SECRET=
# LP_APPROVER_ROLE=LeadershipPilot.Approver

# Mission Control suite: hand problems and personas to Backlog Pilot (server to server).
# Use the same token as Backlog Pilot's BP_SUITE_TOKEN. Leave blank to run standalone.
# LP_BACKLOG_URL=http://localhost:8000
# LP_SUITE_TOKEN=
# LP_PUBLIC_URL=http://localhost:8010

# Weekly update delivery. "simulate" (default) records the exact message and sends nothing.
LP_DELIVERY_MODE=simulate
# Outlook through Microsoft Graph (app registration with Mail.ReadWrite to save drafts, or
# Mail.Send to send). Drafts land in the sender's Drafts folder to review and send in Outlook.
# LP_GRAPH_TENANT_ID=
# LP_GRAPH_CLIENT_ID=
# LP_GRAPH_CLIENT_SECRET=
# LP_OUTLOOK_SENDER=you@company.com
# LP_OUTLOOK_MODE=draft          # draft | send
# Teams: a Workflows "post to a channel when a webhook request is received" URL.
# LP_TEAMS_WEBHOOK_URL=
# Slack: an incoming webhook, or a bot token plus channel (chat.postMessage).
# LP_SLACK_WEBHOOK_URL=
# LP_SLACK_BOT_TOKEN=
# LP_SLACK_CHANNEL=#eng-it-leadership

# Mission Control launcher: the same value in every suite app. The app name in the app bar
# opens a menu of these apps. Adding an app = adding it here, in each app's settings.
# MISSION_CONTROL_APPS=Backlog Pilot=http://127.0.0.1:8000, Leadership Pilot=http://127.0.0.1:8010, PLM Insight=http://127.0.0.1:8020
